# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated, e.g. https://example.com (needed behind HTTPS in production)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Chatbot (Groq, OpenAI-compatible API) ----------------------------
# Get a key at https://console.groq.com/keys . Leave empty to use the
# built-in offline assistant (keyword based, answers from your database).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
CHATBOT_MAX_MESSAGES_PER_HOUR=40

# --- Email ------------------------------------------------------------
# console backend prints mail to the terminal; use smtp in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
# Who receives contact-form / new-booking notifications (optional)
CONTACT_RECIPIENT_EMAIL=

# --- Maps (optional) ---------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Payments (Stripe Checkout) ----------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys . Empty = online payment disabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/payments/webhook/` or the dashboard webhook page
STRIPE_WEBHOOK_SECRET=
# Must match the currency symbol you show in Customization (usd, eur, egp, ...)
STRIPE_CURRENCY=usd
